<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 로그 패턴 색상 적용 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />

    <!-- Spring Property 매핑 -->
    <springProperty name="LOG_TRACE_PATH" source="log.config.trace.path" />
    <springProperty name="LOG_TRACE_FILE_NAME" source="log.config.trace.filename" />
    <springProperty name="LOG_PATH" source="log.config.error.path" />
    <springProperty name="LOG_FILE_NAME" source="log.config.error.filename" />
    <springProperty name="LOG_MAX_HISTORY" source="log.config.maxHistory" />
    <springProperty name="LOG_TOTAL_SIZE_CAP" source="log.config.totalSizeCap" />

    <!-- 로그 패턴 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="[%d{yyyy-MM-dd HH:mm:ss}] %clr(%-5level) %clr([%thread]){faint} %clr(%-40.40logger{36}){cyan} - %msg%n"/>

    <property name="FILE_LOG_PATTERN"
              value="[%d{yyyy-MM-dd HH:mm:ss}] %-5level [%thread] %-40.40logger{36} : %msg%n"/>

    <!-- 콘솔 로그 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 파일 로그 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- TraceId 전용 로그 -->
    <appender name="TRACEID_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_TRACE_PATH}/${LOG_TRACE_FILE_NAME}.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <filter class="com.homesweet.homesweetback.common.log.TraceIdFilter"/>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_TRACE_PATH}/${LOG_TRACE_FILE_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- QueryDSL SQL 로그 -->
    <logger name="com.querydsl" level="DEBUG"/>

    <!-- Hibernate가 생성한 SQL 출력 -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- PreparedStatement 파라미터 바인딩 출력 (Hibernate 6 기준) -->
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

    <!-- Hibernate JPQL → SQL 변환 정보 -->
    <logger name="org.hibernate.engine.query" level="DEBUG"/>

    <!-- JDBC 실행 정보 -->
    <logger name="org.hibernate.resource.jdbc.internal" level="TRACE"/>

    <!-- HikariCP 커넥션 풀 디버깅 -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- dev 환경: 콘솔 + 파일 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="FILE"/>
        </root>

        <logger name="com.homesweet.homesweetback.common.log.MVCLoggingAspect"
                level="INFO" additivity="false">
            <appender-ref ref="TRACEID_FILE"/>
        </logger>
    </springProfile>

    <!-- prod 환경: 콘솔만 출력 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

</configuration>